# SatNOGS DB API token (required)
# Get one free: https://db.satnogs.org -> register -> profile -> API token
SATNOGS_API_TOKEN=

# OpenAI/Azure AI config (optional - backend falls back to templates without it)
OPENAI_API_KEY=
OPENAI_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_INTENT_DEPLOYMENT=
AZURE_OPENAI_SYNTH_DEPLOYMENT=

# AI service behavior
AI_CACHE_TTL_SECONDS=120
AI_CACHE_MAX_ITEMS=800
QUERY_RATE_WINDOW_S=60
QUERY_RATE_LIMIT=24

# CORS: comma-separated list of allowed frontend origins.
# Default (local dev): http://localhost:3000
# Production example: https://downlink.example.com,https://www.downlink.example.com
ALLOWED_ORIGINS=http://localhost:3000
